// Aval data model. Every table lives in Neon Postgres; nothing user-related is
// stored on the client. Tables and columns are snake_case in the database.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Nested selects load in one query (LATERAL JOIN) instead of one round trip
  // per relation: fewer sequential trips to Neon on every request.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Audience {
  EVERYONE
  CONTACTS // people you share a 1:1 chat with
  NOBODY
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ChatType {
  DIRECT
  GROUP
  CONTACT // one-way chat with a personal contact
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
  SYSTEM
}

enum AttachmentKind {
  AVATAR
  IMAGE
  VIDEO
  FILE
  VOICE
  LINK_PREVIEW // og:image of a link preview, copied into object storage
}

enum AttachmentStatus {
  PENDING // presigned, not yet confirmed
  READY
}

enum ContactVisibility {
  PRIVATE
  PUBLIC
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum NotificationType {
  ACCESS_REQUEST
  ACCESS_APPROVED
  ACCESS_DECLINED
  ACCESS_REVOKED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  username        String    @db.VarChar(20) // as typed (always lowercase today)
  usernameLower   String    @unique @map("username_lower") @db.VarChar(20)
  email           String    @db.VarChar(254)
  emailLower      String    @unique @map("email_lower") @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name") @db.VarChar(64)
  bio             String?   @db.VarChar(160)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  avatarKey       String?   @map("avatar_key") // object-storage key, served via signed URL only
  lastSeenAt      DateTime? @map("last_seen_at")

  // privacy
  lastSeenAudience Audience @default(EVERYONE) @map("last_seen_audience")
  avatarAudience   Audience @default(EVERYONE) @map("avatar_audience")
  messageAudience  Audience @default(EVERYONE) @map("message_audience")

  // notifications
  notifyMessages       Boolean @default(true) @map("notify_messages")
  notifyPreviews       Boolean @default(true) @map("notify_previews")
  notifyAccessRequests Boolean @default(true) @map("notify_access_requests")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       ChatMember[]
  createdChats      Chat[]                 @relation("ChatCreator")
  messages          Message[]              @relation("MessageSender")
  pinnedMessages    Message[]              @relation("MessagePinner")
  attachments       Attachment[]
  reactions         Reaction[]
  receipts          Receipt[]
  hiddenMessages    HiddenMessage[]
  starredMessages   StarredMessage[]
  personalContacts  PersonalContact[]
  accessRequests    ContactAccessRequest[]
  accessGrants      ContactAccessGrant[]
  blocksMade        Block[]                @relation("Blocker")
  blocksReceived    Block[]                @relation("Blocked")
  reportsMade       Report[]               @relation("Reporter")
  reportsReceived   Report[]               @relation("ReportedUser")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  handle            Handle?
  aliasesMade       ContactAlias[]         @relation("AliasOwner")
  aliasesReceived   ContactAlias[]         @relation("AliasTarget")

  // username_lower uses COLLATE "C" (set in the init migration), so the unique
  // btree index also serves `LIKE 'abc%'` prefix search.
  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64) // sha256 hex of the cookie token
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  ipPrefix   String?  @map("ip_prefix") @db.VarChar(64) // truncated IP, for the device list
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// ───────────────────────────── Chats ─────────────────────────────

model Chat {
  id            String    @id @default(uuid(7)) @db.Uuid
  type          ChatType
  title         String?   @db.VarChar(64) // groups only
  description   String?   @db.VarChar(255)
  avatarKey     String?   @map("avatar_key")
  createdById   String?   @map("created_by_id") @db.Uuid
  // DIRECT: "<smallerUserId>:<largerUserId>", prevents duplicate 1:1 chats.
  directKey     String?   @unique @map("direct_key") @db.VarChar(80)
  // CONTACT: the personal contact this one-way chat belongs to.
  contactId     String?   @unique @map("contact_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  createdBy User?            @relation("ChatCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contact   PersonalContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  members   ChatMember[]
  messages  Message[]
  receipts  Receipt[]

  @@index([lastMessageAt])
  @@map("chats")
}

model ChatMember {
  chatId       String     @map("chat_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  role         MemberRole @default(MEMBER)
  joinedAt     DateTime   @default(now()) @map("joined_at")
  // per-user chat list state
  pinnedAt     DateTime?  @map("pinned_at")
  archivedAt   DateTime?  @map("archived_at")
  mutedUntil   DateTime?  @map("muted_until")
  markedUnread Boolean    @default(false) @map("marked_unread")
  clearedAt    DateTime?  @map("cleared_at") // "clear history" for me

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, archivedAt])
  @@map("chat_members")
}

model Message {
  id                String                   @id @default(uuid(7)) @db.Uuid
  chatId            String                   @map("chat_id") @db.Uuid
  senderId          String?                  @map("sender_id") @db.Uuid // null for SYSTEM
  clientId          String?                  @map("client_id") @db.VarChar(64) // idempotency key from the optimistic send
  type              MessageType              @default(TEXT)
  text              String?                  @db.VarChar(4096)
  replyToId         String?                  @map("reply_to_id") @db.Uuid
  forwardedFromId   String?                  @map("forwarded_from_id") @db.Uuid
  forwardedFromName String?                  @map("forwarded_from_name") @db.VarChar(64) // snapshot, survives source deletion
  linkPreview       Json?                    @map("link_preview")
  editedAt          DateTime?                @map("edited_at")
  deletedAt         DateTime?                @map("deleted_at") // deleted for everyone: content is wiped
  pinnedAt          DateTime?                @map("pinned_at")
  pinnedById        String?                  @map("pinned_by_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  // Full-text vector, kept in sync by a trigger defined in the init migration.
  searchVector      Unsupported("tsvector")? @map("search_vector")

  chat          Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User?            @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  pinnedBy      User?            @relation("MessagePinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  replyTo       Message?         @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]        @relation("Replies")
  forwardedFrom Message?         @relation("Forwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards      Message[]        @relation("Forwards")
  attachments   Attachment[]
  reactions     Reaction[]
  hiddenFor     HiddenMessage[]
  starredBy     StarredMessage[]
  reports       Report[]

  @@unique([senderId, clientId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([chatId, pinnedAt])
  @@index([chatId, senderId]) // "has X ever messaged in this chat" (privacy: CONTACTS)
  @@index([searchVector], type: Gin, map: "messages_search_vector_idx")
  @@map("messages")
}

model Attachment {
  id         String           @id @default(uuid(7)) @db.Uuid
  uploaderId String           @map("uploader_id") @db.Uuid
  messageId  String?          @map("message_id") @db.Uuid
  kind       AttachmentKind
  status     AttachmentStatus @default(PENDING)
  // Not unique: a forwarded message references the same stored object. Objects are
  // deleted only when no attachment row points at them any more.
  objectKey  String           @map("object_key")
  mimeType   String           @map("mime_type") @db.VarChar(127)
  sizeBytes  Int              @map("size_bytes")
  fileName   String?          @map("file_name") @db.VarChar(255)
  width      Int?
  height     Int?
  durationMs Int?             @map("duration_ms")
  waveform   Json? // voice notes: downsampled peaks
  createdAt  DateTime         @default(now()) @map("created_at")

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([objectKey])
  @@index([status, createdAt])
  @@index([uploaderId, createdAt])
  @@map("attachments")
}

model Reaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId]) // one reaction per user per message
  @@map("reactions")
}

// Receipts are watermarks per (chat, member): a message is delivered/read for a
// member when its created_at <= that member's watermark. O(1) writes per chat
// instead of one row per message per member.
model Receipt {
  chatId          String    @map("chat_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lastDeliveredAt DateTime? @map("last_delivered_at")
  lastReadAt      DateTime? @map("last_read_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("receipts")
}

model HiddenMessage {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("hidden_messages")
}

model StarredMessage {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("starred_messages")
}

// ───────────────────────────── Personal contacts ─────────────────────────────

model PersonalContact {
  id            String            @id @default(uuid(7)) @db.Uuid
  ownerId       String            @map("owner_id") @db.Uuid
  name          String            @db.VarChar(64)
  nameLower     String            @map("name_lower") @db.VarChar(64)
  // Required @username, in the same namespace as users' (see Handle).
  username      String            @db.VarChar(20)
  usernameLower String            @unique @map("username_lower") @db.VarChar(20)
  avatarKey     String?           @map("avatar_key")
  note          String?           @db.VarChar(500)
  visibility    ContactVisibility @default(PRIVATE)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chat           Chat?
  handle         Handle?
  accessRequests ContactAccessRequest[]
  accessGrants   ContactAccessGrant[]
  reports        Report[]

  @@index([ownerId])
  // name_lower uses COLLATE "C" (init migration) so this index serves prefix search.
  @@index([visibility, nameLower])
  @@map("personal_contacts")
}

/// One namespace for @usernames: every user's and every personal contact's
/// handle is a row here, so a name can't belong to both (the primary key
/// enforces it, even under concurrent sign-ups and contact creation).
model Handle {
  handleLower String  @id @map("handle_lower") @db.VarChar(20)
  userId      String? @unique @map("user_id") @db.Uuid
  contactId   String? @unique @map("contact_id") @db.Uuid

  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact PersonalContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // CHECK (exactly one of user_id / contact_id) is in the migration.
  @@map("handles")
}

/// A private nickname I gave someone: shown instead of their name, to me only.
model ContactAlias {
  ownerId      String   @map("owner_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  alias        String   @db.VarChar(64)
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner  User @relation("AliasOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target User @relation("AliasTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@id([ownerId, targetUserId])
  @@index([targetUserId])
  @@map("contact_aliases")
}

model ContactAccessRequest {
  id          String              @id @default(uuid(7)) @db.Uuid
  contactId   String              @map("contact_id") @db.Uuid
  requesterId String              @map("requester_id") @db.Uuid
  note        String?             @db.VarChar(280)
  status      AccessRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now()) @map("created_at")
  decidedAt   DateTime?           @map("decided_at")

  contact   PersonalContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requester User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([contactId, requesterId]) // one row per pair; re-requests reuse it
  @@index([contactId, status])
  @@index([requesterId])
  @@map("contact_access_requests")
}

model ContactAccessGrant {
  contactId String   @map("contact_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  contact PersonalContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contactId, userId])
  @@index([userId])
  @@map("contact_access_grants")
}

// ───────────────────────────── Safety ─────────────────────────────

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id              String       @id @default(uuid(7)) @db.Uuid
  reporterId      String       @map("reporter_id") @db.Uuid
  targetUserId    String?      @map("target_user_id") @db.Uuid
  targetMessageId String?      @map("target_message_id") @db.Uuid
  targetContactId String?      @map("target_contact_id") @db.Uuid
  reason          ReportReason
  details         String?      @db.VarChar(1000)
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now()) @map("created_at")

  reporter      User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser    User?            @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetMessage Message?         @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)
  targetContact PersonalContact? @relation(fields: [targetContactId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@map("reports")
}

// ───────────────────────────── Notifications ─────────────────────────────

model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}
