# ─────────────────────────────────────────────────────────────────────────────
# Aval environment. Copy to `.env` for local dev; set the same keys in Vercel
# (Project → Settings → Environment Variables) for Preview and Production.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app, no trailing slash. Used in email links and CSRF checks.
APP_URL="http://localhost:3000"

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/aval?sslmode=require"
# Direct (unpooled) connection, used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/aval?sslmode=require"
# Local `prisma dev` only: its separate shadow server, needed by `prisma migrate dev`.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ── Rate limiting (Upstash Redis) — required in production ───────────────────
# Without these in development, an in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (SMTP) — required in production ────────────────────────────────────
# Without SMTP_HOST in development, emails are printed to the server console.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aval <no-reply@your-domain.com>"

# ── Media (Cloudflare R2) — required in production ───────────────────────────
# Without these in development, uploads return 503 and everything else works.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="aval-media"
# Development only: an S3-compatible endpoint (MinIO, s3rver) instead of R2.
# R2_ENDPOINT="http://localhost:4569"

# ── Real-time (Ably) — strongly recommended ──────────────────────────────────
# Root/API key with publish, subscribe, presence and history capabilities. It never
# reaches the browser: clients get short-lived tokens scoped to their own channel.
# Without it the app still works, but falls back to polling (no typing indicators).
ABLY_API_KEY=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/sweep. Any long random string.
CRON_SECRET=""

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. Without keys the app
# works and simply sends no push notifications. Never rotate casually: every
# existing subscription is tied to the public key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@your-domain.com"
