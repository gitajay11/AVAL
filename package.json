{
  "name": "aval",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:live": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed-dev.mts",
    "db:explain": "tsx --conditions=react-server scripts/explain.mts",
    "db:explain:live": "tsx --conditions=react-server --env-file=.env scripts/explain.mts",
    "icons": "tsx scripts/icons.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ably": "^2.29.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-virtuoso": "^4.18.19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.5.1"
}
