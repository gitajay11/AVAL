# ─────────────────────────────────────────────────────────────────────────────
# Aval environment. Two git-ignored copies of this file:
#   .env.local  local development (wins on your machine; leave DIRECT_URL blank)
#   .env        the live site's values; copy them into Vercel (Project → Settings
#               → Environment Variables) for Production and Preview.
# Blank values (KEY="") count as unset. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app, no trailing slash. Used in email links and CSRF checks.
APP_URL="http://localhost:3000"

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/aval?sslmode=require"
# Direct (unpooled) connection, used only by `prisma migrate`. `neon env pull` /
# `neon deploy` write it as DATABASE_URL_UNPOOLED (plus NEON_BRANCH); DIRECT_URL
# is accepted too. In .env.local, keep both blank.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/aval?sslmode=require"
# Local `prisma dev` only: its separate shadow server, needed by `prisma migrate dev`.
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ── Rate limiting (Upstash Redis) — required in production ───────────────────
# Without these in development, an in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ── Email (SMTP) — required in production ────────────────────────────────────
# Without SMTP_HOST in development, emails are printed to the server console.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aval <no-reply@your-domain.com>"

# ── Media (Neon Object Storage) — required in production ─────────────────────
# Bucket declared in neon.ts; `neon deploy` writes the four AWS_* values for the
# linked branch into .env. In .env.local, point them at a local S3 emulator
# (s3rver/MinIO, e.g. http://localhost:4569). Without them in development,
# uploads return 503 and everything else works.
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-1.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
STORAGE_BUCKET="aval-media"

# ── Real-time (Ably) — strongly recommended ──────────────────────────────────
# Root/API key with publish, subscribe, presence and history capabilities. It never
# reaches the browser: clients get short-lived tokens scoped to their own channel.
# Without it the app still works, but falls back to polling (no typing indicators).
ABLY_API_KEY=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/sweep. Any long random string.
CRON_SECRET=""

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. Without keys the app
# works and simply sends no push notifications. Never rotate casually: every
# existing subscription is tied to the public key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@your-domain.com"
